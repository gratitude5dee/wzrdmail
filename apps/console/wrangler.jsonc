// wzrdmail console SPA → console.mail.wzrd.tech (goal-console.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wzrdmail-console",
  "compatibility_date": "2025-02-04",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "routes": [{ "pattern": "staging.console.mail.wzrd.tech", "custom_domain": true }]
    },
    "production": {
      "workers_dev": true,
      "routes": [{ "pattern": "console.mail.wzrd.tech", "custom_domain": true }]
    }
  }
}
