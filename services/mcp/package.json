{
  "name": "@wzrdmail/mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:ui && tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm build:ui && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "pnpm build:ui && vitest run",
    "dev": "pnpm build:ui && wrangler dev",
    "deploy:staging": "pnpm build:ui && wrangler deploy --env staging",
    "deploy:prod": "pnpm build:ui && wrangler deploy --env production",
    "build:ui": "node scripts/build-ui.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@wzrdmail/core": "workspace:*",
    "agents": "^0.21.0",
    "wzrdmail": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@openai/mcp-extensions": "^0.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.124.0"
  }
}
