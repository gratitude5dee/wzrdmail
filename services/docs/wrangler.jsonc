// wzrdmail docs Worker → mail.wzrd.tech/docs (§14 of goal.md), reached
// through the landing Worker's DOCS service binding; not publicly routed.
// Static markdown corpus rendered per-request; no storage bindings needed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wzrdmail-docs",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WZRDMAIL_ENV": "dev"
  },
  "env": {
    "staging": {
      "vars": { "WZRDMAIL_ENV": "staging", "DOCS_BASE_PATH": "/docs" },
      "workers_dev": true
    },
    "production": {
      "vars": { "WZRDMAIL_ENV": "prod", "DOCS_BASE_PATH": "/docs" },
      "workers_dev": true
    }
  }
}
